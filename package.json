{
  "name": "gerda",
  "version": "0.2.10",
  "description": "",
  "author": "shevernitskiy <mahahuha@ya.ru>",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "start": "bun run --no-env-file ./src/main.ts",
    "start:debug": "bun run --no-env-file --debug --hot ./src/main.ts",
    "start:prod": "bun build:client && bun start",
    "lint": "oxlint --fix",
    "test:all": "bun test --no-env-file --timeout=30000 ./test/cdek ./test/app.e2e-spec.ts",
    "test:cov": "bun test --no-env-file --timeout=30000 --coverage ./test/cdek ./test/app.e2e-spec.ts",
    "boilerplate": "bun test --no-env-file --timeout=30000 ./test/boilerplate.spec.ts",
    "build:client": "bun ./scripts/build-client.ts",
    "build:app:windows": "bun build ./src/main.ts --compile --sourcemap --target=bun-windows-x64 --no-compile-autoload-dotenv --outfile nest.exe --external @nestjs/microservices --external @nestjs/websockets",
    "build:app:linux-x64": "bun build ./src/main.ts --compile --sourcemap --target=bun-linux-x64 --no-compile-autoload-dotenv --outfile nest --external @nestjs/microservices --external @nestjs/websockets",
    "build:app:linux-arm64": "bun build ./src/main.ts --compile --sourcemap --target=bun-linux-arm64 --no-compile-autoload-dotenv --outfile nest --external @nestjs/microservices --external @nestjs/websockets",
    "tail": "bun ./scripts/tail-logs.ts"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.0",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.0",
    "@nestjs/platform-express": "^12.0.0",
    "@nestjs/schedule": "^12.0.1",
    "@pdf-lib/fontkit": "^1.1.1",
    "@shevernitskiy/amo": "^0.2.16",
    "@shevernitskiy/post-calculator": "^0.1.3",
    "@shevernitskiy/post-tracking": "^0.1.2",
    "cdek": "^2.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "google-auth-library": "^11.0.2",
    "google-spreadsheet": "^5.3.0",
    "grammy": "^1.46.0",
    "handlebars": "^4.7.9",
    "imapflow": "^1.7.6",
    "lru-cache": "^11.5.2",
    "nest-winston": "^1.10.2",
    "nodemailer": "^9.0.6",
    "number-to-words-ru": "^2.4.1",
    "pdf-lib": "^1.17.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "winston": "^3.18.3",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.0",
    "@types/bun": "^1.4.0",
    "@types/express": "^5.0.6",
    "@types/jquery": "^4.0.1",
    "@types/node": "^26.4.0",
    "@types/nodemailer": "^8.0.1",
    "eventsource": "^5.1.1",
    "msw": "^2.15.0",
    "oxlint": "^1.80.0",
    "pactum": "^3.9.1",
    "typescript": "^6.0.0"
  },
  "overrides": {
    "whatwg-url": "14.0.0",
    "mailparser": "3.7.1"
  },
  "trustedDependencies": [
    "@nestjs/core",
    "msw"
  ]
}
